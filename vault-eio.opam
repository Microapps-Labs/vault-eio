opam-version: "2.0"
synopsis: "HashiCorp Vault helpers for OCaml Eio applications"
maintainer: "OlegHQ"
authors: "OlegHQ"
license: "MIT"
homepage: "https://github.com/OlegHQ/vault-eio"
bug-reports: "https://github.com/OlegHQ/vault-eio/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.22"}
  "cohttp"
  "cohttp-eio"
  "eio"
  "yojson"
  "uri"
  "ca-certs"
  "tls"
  "tls-eio"
  "domain-name"
]
build: [
  ["dune" "subst"]
  ["dune" "build" "-p" name "-j" jobs]
]
